{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": { "baseURL": "http://${HOST}:${PORT}/v1" },
      "models": {
        "${MODEL_ID}": {
          "name": "${MODEL}",
          "limit": { "context": ${CTX}, "output": 4096 }
        }
      }
    }
  }
}
